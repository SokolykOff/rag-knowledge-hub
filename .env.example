# --- Core ---
RAG_ENV=dev
DATABASE_URL=postgresql+asyncpg://rag:rag@localhost:5432/rag
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP=localhost:19092
# kafka | memory (memory = in-process bus, no broker needed)
EVENT_BUS=memory
# redis | memory
CACHE_BACKEND=redis

# --- Auth: token:tenant:role,token:tenant:role (roles: guest, employee, manager, admin) ---
# Empty + DEMO_MODE=true => built-in demo tokens for tenants acme/globex.
RAG_ROLE_TOKENS=
DEMO_MODE=true
SEED_DEMO=true

# --- Optional OpenAI-compatible providers (empty => free local fallback) ---
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# --- Bitrix24 ---
B24_APPLICATION_TOKEN=demo-b24-token
B24_WEBHOOK_URL=
B24_DRY_RUN=true
B24_TENANT_ID=acme

# --- Retrieval tuning ---
MIN_SIMILARITY=0.22
MIN_OVERLAP=0.34
RATE_LIMIT_PER_MIN=60
